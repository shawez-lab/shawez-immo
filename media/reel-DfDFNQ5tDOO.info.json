g=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=1VgV3H49sfUQ7kNvwEnaCDX&_nc_oc=AdqnTv9klqUyBX0AV7k8XWwOOhUq--eqgHPjshWm0WcgfPb4b2REH6ORMKS1O5jKLXs&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=qiDf1rshxeXMb176NA59kw&_nc_ss=70689&oh=00_AQQ_AW6Mul8BpcgFak9sTMdXrRzLQZTMKOj--KTxWyKKzQ&oe=6AE83043", "width": 720, "height": 720, "id": "10", "resolution": "720x720"}, {"url": "https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/868957530_18104499785324929_1291185668206810320_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=NDAxODA3ODE5NDI3ODM0NzY2MjE4MTA0NDk5NzgyMzI0OTI5.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=1VgV3H49sfUQ7kNvwEnaCDX&_nc_oc=AdqnTv9klqUyBX0AV7k8XWwOOhUq--eqgHPjshWm0WcgfPb4b2REH6ORMKS1O5jKLXs&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=qiDf1rshxeXMb176NA59kw&_nc_ss=70689&oh=00_AQT08_9X9bmjApwM3-HE9VqQZ3y29Dkn_HB6pVJMpRQIZA&oe=6AE83043", "width": 720, "height": 1280, "id": "11", "resolution": "720x1280"}], "comments": [{"author": "shawez_immo", "author_id": "39659804928", "id": "18119951072083732", "text": "Beaune, historic centre. One courtyard, two floors, two completely different styles.\n⠀\nComment VISIT or message me and I'll send you the full file.\n⠀\nShawez Ali — real estate agent in Dijon, covering Beaune and the whole Côte d'Or.\n⠀\nEnergy class: [DPE]. Agency fees paid by the seller.", "timestamp": 1793212686, "like_count": 0}, {"author": "shawez_immo", "author_id": "39659804928", "id": "18120776702470093", "text": "€2.5 million in Burgundy. Same building, two completely different lives.\n⠀\nFrom the street, it’s just another stone façade in the heart of Beaune. You’d walk straight past it.\n⠀\nPush the door and there’s a private courtyard with a timber gallery on old stone columns. Go up one floor and the style changes completely — beams, light, parquet, and a kind of quiet you don’t get in a new build.\n⠀\nThis is the France everyone says they dream about and nobody ever checks the price of. So I filmed both floors for you.\n⠀\nGround floor or the one upstairs — which would you take? Tell me below, I read every comment.\n⠀\nFor the real details, comment VISIT and I’ll send them to you in a private message.\n⠀\nAnd send this to the person you’d be buying it with.\n⠀\nBeaune, Côte d’Or — just over two hours from Paris by train, in the middle of the Burgundy wine country.\n⠀\n#beaune #burgundy #frenchproperty #cotedor #frenchrealestate", "timestamp": 1793212605, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DfDFNQ5tDOO/", "webpage_url_basename": "DfDFNQ5tDOO", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "thumbnail": "https://scontent-sjc6-1.cdninstagram.com/v/t51.82787-15/868957530_18104499785324929_1291185668206810320_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=100&ig_cache_key=NDAxODA3ODE5NDI3ODM0NzY2MjE4MTA0NDk5NzgyMzI0OTI5.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjcyMC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=1VgV3H49sfUQ7kNvwEnaCDX&_nc_oc=AdqnTv9klqUyBX0AV7k8XWwOOhUq--eqgHPjshWm0WcgfPb4b2REH6ORMKS1O5jKLXs&_nc_zt=23&_nc_ht=scontent-sjc6-1.cdninstagram.com&_nc_gid=qiDf1rshxeXMb176NA59kw&_nc_ss=70689&oh=00_AQT08_9X9bmjApwM3-HE9VqQZ3y29Dkn_HB6pVJMpRQIZA&oe=6AE83043", "display_id": "DfDFNQ5tDOO", "fulltitle": "Video by shawez_immo", "upload_date": "20261028", "epoch": 1793216195, "format": "dash-3219028038300134v - 1080x1920 (DASH video)+dash-3219027801633491a - audio only (DASH audio)", "format_id": "dash-3219028038300134v+dash-3219027801633491a", "ext": "mp4", "protocol": "https+https", "format_note": "DASH video+DASH audio", "tbr": 2304.18, "width": 1080, "height": 1920, "resolution": "1080x1920", "dynamic_range": "SDR", "vcodec": "vp09.00.40.08.00.01.01.01.00", "vbr": 2243.191, "aspect_ratio": 0.56, "acodec": "mp4a.40.5", "abr": 6